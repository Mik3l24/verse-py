external function named PrintToStdOut in C printf
returning Int32
target
    constant CString named message,
arguments
    variadic
end.

function returning Int32 named main
procedure
    PrintToStdOut "Hello World!\n".
    PrintToStdOut ":%d\n" with 3.
    PrintToStdOut "%s%s%s\n" with "A", "B", "C".
    return 0.
end
